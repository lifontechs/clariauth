# ── Leads inbox ────────────────────────────────────────────────────────────
# The inbox lives at /inbox/<NUXT_ADMIN_TOKEN>. The URL IS the password, so
# use a long random value and treat the link as a secret. Minimum 24 chars;
# the inbox stays disabled (404) below that or if unset.
#   generate one with:  openssl rand -hex 32
NUXT_ADMIN_TOKEN=

# ── Database ───────────────────────────────────────────────────────────────
# SQLite file holding submissions. Must sit on a PERSISTENT disk — on an
# ephemeral/serverless filesystem it is wiped on every deploy. See the README.
NUXT_DATABASE_PATH=.data/clariauth.sqlite

# ── Email notifications ────────────────────────────────────────────────────
# Any SMTP provider works (Resend, Postmark, SES, Mailgun, Google Workspace).
# Leave blank to skip email entirely: submissions are still stored and still
# readable in the inbox, they just do not notify anyone.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
# Envelope sender — must be an address/domain your provider lets you send as.
NUXT_SMTP_FROM="ClariAuth <noreply@clariauth.com>"
# Where new-lead notifications land.
NUXT_SMTP_TO=info@clariauth.com

# ── Optional ───────────────────────────────────────────────────────────────
# Point the form at an external service instead of the built-in API.
# NUXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
